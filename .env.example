# Copy to .env at the repo root. Every app reads it (api/workers via --env-file, web via next.config).

# --- infra
DATABASE_URL=postgresql://sway:sway@localhost:5432/sway
REDIS_URL=redis://localhost:6379
API_PORT=4000
API_HOST=0.0.0.0
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# 32+ random bytes; signs the session cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# --- X (Twitter) OAuth 2.0, read-only scopes: tweet.read users.read follows.read offline.access
X_CLIENT_ID=
X_CLIENT_SECRET=
X_BEARER_TOKEN=
X_CALLBACK_URL=http://localhost:3000/api/auth/x/callback
# Id of the official launch post (the "Repost the launch post" task).
X_LAUNCH_POST_ID=
# Demo sign-in without X (handle + optional followers, like the prototype). Never enable in production.
DEV_AUTH=1
# Dev sign-in only: how long a task "verification" takes.
DEV_VERIFY_DELAY_MS=1200

# --- chain (local anvil by default; testnet values from the Robinhood Chain docs)
CHAIN_ID=31337
CHAIN_NAME=
RPC_URL=http://127.0.0.1:8545
# RPC the browser uses (defaults to RPC_URL); point at a public endpoint when RPC_URL is private.
PUBLIC_RPC_URL=
# Multicall3 for batched balance reads (defaults to the canonical address when deployed on the chain).
MULTICALL3_ADDRESS=
EXPLORER_URL=
# Contracts are unaudited: the API refuses chain 4663 (mainnet) unless this is 1.
SWAY_ENABLE_MAINNET=0
INDEXER_START_BLOCK=0
INDEXER_CONFIRMATIONS=2

SWAY_KEYS_ADDRESS=
SWAY_STAKING_ADDRESS=
GENESIS_PASS_ADDRESS=
FAN_ESCROW_ADDRESS=
LAUNCHPAD_ADDRESS=
DROPS_ADDRESS=

# Operator: opens markets, sets referrers, claims fan markets. Keep in a secrets manager.
OPERATOR_PRIVATE_KEY=
# Genesis minter. Keep in a secrets manager.
ISSUER_PRIVATE_KEY=

# --- wallets
# privy | cdp | burner (burner = a key made and kept in the member's browser)
EMBEDDED_WALLET_PROVIDER=burner
# 1 = also offer "Create a Sway wallet" (burner) on mainnet. Members are asked to back up the key right after.
BROWSER_WALLETS_ON_MAINNET=0
EMBEDDED_WALLET_API_KEY=
WALLETCONNECT_PROJECT_ID=
# Gas drip (wei): the operator sends this once to a new member's account wallet on a non-local chain when
# they signed in with X and their X account is >= 30 days old with >= 50 followers and no bot flag.
# 0 = off. Example for a testnet: 200000000000000 (0.0002 ETH).
GAS_DRIP_WEI=0
# 1 = the operator pays to open members' markets, claim fan markets and set referrers at sign-up.
# 0 (default): it signs permits and the first buy that needs one carries it, so joining costs Sway nothing.
SPONSOR_ONBOARDING=0
# Testnet faucet page linked from the Deposit modal (local chains use the built-in dev faucet).
FAUCET_URL=
# Telegram group for the "Join the Telegram" task (its Join button). Empty = the task only has Skip and Verify.
TELEGRAM_URL=

# Web push (VAPID). Generate once with `node scripts/vapid-keys.mjs`; leave empty to turn push off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@swayfamily.com

# --- api limits and logs
LOG_LEVEL=info
RATE_LIMIT_MAX=600
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_X_MAX=10

# --- prices
# JSON endpoint returning ETH/USD. Coinbase spot shape is supported: {"data":{"amount":"3420.12"}}
ETH_USD_FEED_URL=https://api.coinbase.com/v2/prices/ETH-USD/spot
ETH_USD_FALLBACK=3420

# --- social, moderation & admin
# X handles (comma-separated) made admins at every sign-in; admins can grant more in /admin.
ADMIN_HANDLES=
# Post images (default <repo>/uploads). Back this directory up with the database.
UPLOAD_DIR=
# Price of a 24h post boost in USD, paid in ETH to the treasury (default SwayKeys.treasury()).
BOOST_USD=10
TREASURY_ADDRESS=

# --- workers monitoring
# /healthz and /metrics (Prometheus) for uptime checks; alert when /healthz returns 503.
WORKERS_HEALTH_PORT=4100
# /healthz turns unhealthy when the indexer is this many blocks behind the chain head.
INDEXER_MAX_LAG=60

# --- backups (deploy/backup.sh)
BACKUP_DIR=/var/backups/sway
BACKUP_KEEP_DAYS=14

# --- launch events
SNAPSHOT_AT=2026-10-27T15:00:00Z
GENESIS_MIN_SCORE=10
# $SWAY units (18 decimals) in the Genesis pool: 5% of supply. Placeholder until the token is final.
GENESIS_POOL_UNITS=50000000000000000000000000

# --- token
# 1 = announce $SWAY: the site shows the token @swaydotfamily launched (CA card, token page, holder airdrop).
# 0 (default) = "CA: Coming soon" everywhere, even if a token exists onchain; restart the API after changing it.
SWAY_TOKEN_PUBLIC=0
# The ticker shown on the site (e.g. SWAY). Empty (default) = "Sway token" everywhere until launch; rebuild the
# web after setting it.
NEXT_PUBLIC_SWAY_TICKER=
# Pins the $SWAY address shown on the site (copy button), whatever SWAY_TOKEN_PUBLIC says. Leave it empty
# until launch. Rebuild the web after setting it.
NEXT_PUBLIC_SWAY_CA=
