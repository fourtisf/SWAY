# Copy to .env at the repo root. Every app reads it (api/workers via --env-file, web via next.config).

# --- infra
DATABASE_URL=postgresql://sway:sway@localhost:5432/sway
REDIS_URL=redis://localhost:6379
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# 32+ random bytes; signs the session cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# --- X (Twitter) OAuth 2.0, read-only scopes: tweet.read users.read follows.read offline.access
X_CLIENT_ID=
X_CLIENT_SECRET=
X_BEARER_TOKEN=
X_CALLBACK_URL=http://localhost:3000/api/auth/x/callback
# Demo sign-in without X (handle + optional followers, like the prototype). Never enable in production.
DEV_AUTH=1

# --- chain (local anvil by default; testnet values from the Robinhood Chain docs)
CHAIN_ID=31337
CHAIN_NAME=
RPC_URL=http://127.0.0.1:8545
EXPLORER_URL=
# Contracts are unaudited: the API refuses chain 4663 (mainnet) unless this is 1.
SWAY_ENABLE_MAINNET=0
INDEXER_START_BLOCK=0
INDEXER_CONFIRMATIONS=2

SWAY_KEYS_ADDRESS=
SWAY_STAKING_ADDRESS=
GENESIS_PASS_ADDRESS=
FAN_ESCROW_ADDRESS=
LAUNCHPAD_ADDRESS=

# Operator: opens markets, sets referrers, claims fan markets. Keep in a secrets manager.
OPERATOR_PRIVATE_KEY=
# Genesis minter. Keep in a secrets manager.
ISSUER_PRIVATE_KEY=

# --- wallets
# privy | cdp | burner (burner = browser-generated key, local/testnet only)
EMBEDDED_WALLET_PROVIDER=burner
EMBEDDED_WALLET_API_KEY=
WALLETCONNECT_PROJECT_ID=

# --- prices
# JSON endpoint returning ETH/USD. Coinbase spot shape is supported: {"data":{"amount":"3420.12"}}
ETH_USD_FEED_URL=https://api.coinbase.com/v2/prices/ETH-USD/spot
ETH_USD_FALLBACK=3420

# --- launch events
SNAPSHOT_AT=2026-10-27T15:00:00Z
GENESIS_MIN_SCORE=10
