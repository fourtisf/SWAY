{
  "name": "@sway/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sway API: Fastify REST + WebSocket.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/websocket": "11.3.3",
    "@sway/curve": "workspace:*",
    "@sway/db": "workspace:*",
    "@sway/scoring": "workspace:*",
    "@sway/shared": "workspace:*",
    "fastify": "5.12.5",
    "ioredis": "5.11.1",
    "viem": "2.57.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "pino-pretty": "13.2.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "vitest": "3.2.7"
  }
}
