{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "jsx": "preserve",
    "allowJs": false,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "tailwind.config.ts",
    ".next/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e-c/types/**/*.ts",
    ".next-e2e-a/types/**/*.ts",
    ".next-e2e-b/types/**/*.ts",
    ".next-c/types/**/*.ts",
    ".next-a/types/**/*.ts",
    ".next-build-b/types/**/*.ts",
    ".next-b/types/**/*.ts",
    ".next-e2e-a-dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
